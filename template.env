# ========================= API 設定 =========================

# 後端 API 伺服器位址（Flask）
VITE_API_BASE_URL=http://localhost:5656

# 開關：true = 前端使用 mock data，不打真實 API；false = 打上面的 API_BASE_URL
VITE_USE_MOCK_DATA=true

# ========================= Mock 延遲設定 =========================
# 模擬網路延遲時間（毫秒），只有 VITE_USE_MOCK_DATA=true 時生效
# 依真實 API 的實際反應時間調整，讓開發時的 loading 狀態更貼近正式環境

# /count 端點的模擬延遲
VITE_MOCK_DELAY_COUNT=300

# /upload 端點的模擬延遲（模型推論耗時較久，數值設較高）
VITE_MOCK_DELAY_UPLOAD=800

# Ghost Domain
VITE_GALLERY_URL=https://localhost:5566